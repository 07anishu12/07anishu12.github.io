# ==============================================================================
# Medium Article Synchronisation Configuration
# ==============================================================================
#
# NOTE: Medium currently states that it does not issue new API integration tokens
# or permit new API integrations. Previously issued integration tokens may continue
# to work.
#
# If you possess a previously issued Medium integration token:
# 1. Supply it below for local testing, or add it as a GitHub Actions Secret named:
#    MEDIUM_INTEGRATION_TOKEN
#    in your GitHub repository settings: Settings -> Secrets and variables -> Actions.
# 2. Never commit your actual token to version control.
#
# If you DO NOT have a previously issued token:
# Leave this unset. The system will automatically run in official semi-automated
# import-queue mode, generating a structured queue in docs/medium-import-queue.md
# and providing direct links to Medium's official webpage importer (https://medium.com/p/import).
#
MEDIUM_INTEGRATION_TOKEN=your_medium_integration_token_here

# Default story publication status ('public', 'draft', or 'unlisted')
# 'public'   - Publishes the story immediately to your Medium profile
# 'draft'    - Creates the story as a Medium draft for final review before publishing
# 'unlisted' - Publishes the story without appearing in public feeds or search
MEDIUM_PUBLISH_STATUS=public

# ==============================================================================
# Google Sheets Database Integration (Server-Side Only - Never prefix with NEXT_PUBLIC_)
# ==============================================================================
# Target Google Sheet ID (Spreadsheet: "Database of the leads")
GOOGLE_SHEETS_SPREADSHEET_ID=1aA0G58mRv5ursWNuIDoDWkotXbBrTqf6vTIQKno3LV4

# Deployed Google Apps Script Web App exec URL
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYED_EXEC_URL/exec

# Integration secret generated locally and configured in Script Properties
GOOGLE_SHEETS_API_SECRET=your_generated_random_secret_here

# Optional tuning
GOOGLE_SHEETS_TIMEOUT_MS=8000
GOOGLE_SHEETS_MAX_RETRIES=2
