NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
MAX_BODY_BYTES=32768
REQUEST_TIMEOUT_MS=10000
UPSTREAM_TIMEOUT_MS=5000

# Contact delivery. Keep provider credentials server-side only.
CONTACT_PROVIDER=none
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Comma-separated allowlist of public repositories, for example:
# 07anishu12/Finance-tools,07anishu12/lead-agent
GITHUB_PUBLIC_REPOS=
GITHUB_TOKEN=

CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5
MIN_FORM_AGE_MS=1500

# Lead storage; use a dedicated PostgreSQL database and runtime role.
DATABASE_URL=
LEAD_TOKEN_SECRET=
# Server-only Google Sheets configuration. Never use NEXT_PUBLIC_ names.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Owner-only WhatsApp template notification, disabled until configured and approved.
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
