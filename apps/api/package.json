{
  "name": "@portfolio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @portfolio/contracts build && tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "test": "pnpm --filter @portfolio/contracts build && node --import tsx --test tests/**/*.test.ts",
    "typecheck": "pnpm --filter @portfolio/contracts build && tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "worker:once": "node --env-file-if-exists=.env --import tsx src/worker.ts --once"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@portfolio/contracts": "workspace:*",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
